generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cook {
  id               String    @id @default(uuid())
  userId           String?
  name             String
  phone            String    @unique
  tier             Int       @default(1)
  status           String    @default("Kitchen_Pending")
  dob              String?
  whatsapp         String?
  altContact       String?
  aadhaarNo        String?
  panNo            String?
  isVegOnly        Boolean   @default(false)
  hasExistingFssai Boolean   @default(false)
  fssaiNumber      String?
  fssaiExpiry      String?
  lat              Float?
  lng              Float?
  meals            String?
  capacity         Int?
  cutoffNotice     String?
  weeklyOff        String?
  packagingType    String?
  deliveryMode     String?
  selfieUrl        String?
  aadhaarUrl       String?
  panUrl           String?
  cookingUrl       String?
  storageUrl       String?
  sinkUrl          String?
  fcmToken         String?
  address          String?
  kitchenName      String?
  bannerUrl        String?
  about            String?
  cuisines         String?
  streetAddress    String?
  landmark         String?
  city             String?
  state            String?
  pincode          String?
  fssaiUrl         String?
  appliedAt        DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PlatformConfig {
  id                    String   @id @default("default")
  platformCommission    Float    @default(15.0)
  customerDeliveryFee   Float    @default(25.0)
  cookSignupBonus       Float    @default(500.0)
  platformFee           Float    @default(10.0)
  privacyPolicyUrl      String   @default("https://example.com/privacy")
  termsAndConditionUrl  String   @default("https://example.com/terms")
  defaultStateRadius    Float    @default(100000.0)
  defaultCityRadius     Float    @default(15000.0)
  defaultVillageRadius  Float    @default(5000.0)
  payoutCycle           String   @default("Weekly · Friday 6 PM IST")
  minimumPayout         Float    @default(500.0)
  bankRail              String   @default("UPI · NEFT fallback")
  updatedAt             DateTime @updatedAt
}

model Coupon {
  id                    String   @id @default(uuid())
  code                  String   @unique
  description           String
  type                  String   // "flat" | "percent" | "free_delivery"
  value                 Float
  redemptions           Int      @default(0)
  cap                   Int      @default(9999)
  status                String   @default("active") // "active" | "scheduled" | "expired"
  endsAt                DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Cuisine {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
//  USER  (Customer) — separate from Cook. The same phone may have BOTH a
//  User (customer) record and a Cook (kitchen) record; they are independent.
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id            String   @id @default(uuid())
  name          String
  email         String?
  phone         String   @unique
  dob           String?
  profilePicUrl String?
  fcmToken      String?
  status        String   @default("Active") // "Active" | "Blocked"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
//  MENU ITEM  (a dish belonging to a Cook / kitchen)
// ─────────────────────────────────────────────────────────────────────────────
model MenuItem {
  id          String   @id @default(uuid())
  cookId      String // owning kitchen (Cook.id, from the auth token)
  name        String
  price       Float
  perDay      Int      @default(0) // quantity available per day
  imageUrl    String?
  diet        String   @default("Veg") // "Veg" | "Non-veg" | "Vegan" | "Jain"
  spice       String   @default("Medium") // "Mild" | "Medium" | "Spicy" | "Extra spicy"
  eggless     Boolean  @default(true)
  portion     String?
  ingredients String?
  description String?
  isAvailable Boolean  @default(true) // menu on / off
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cookId])
}
